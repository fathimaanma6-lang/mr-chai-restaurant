# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file to Git.

# Server
PORT=5000
NODE_ENV=development

# MySQL Database (matches phpMyAdmin / XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mr_chai_restaurant

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

ADMIN_JWT_SECRET=change_this_to_a_different_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# Default admin account created by "npm run seed:admin"
DEFAULT_ADMIN_EMAIL=admin@mrchai.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# SMS notifications (Twilio)
# Leave these BLANK to run in DEMO mode — SMS messages will just be printed
# to the server console instead of actually sent. Fill them in with a real
# Twilio account to send real SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# The restaurant owner's phone number — receives a text for every new paid
# order (with customer name, phone, and total). Use E.164 format, e.g. +94771234567
ADMIN_PHONE_NUMBER=
